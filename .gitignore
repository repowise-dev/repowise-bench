# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.env

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude Code's local state for this checkout. `.claude/worktrees/` alone is
# 311 MB of git worktrees, which is agent scratch and not benchmark evidence.
/.claude/

# Cloned target repositories — fetched on demand by scripts/download_benchmarks.py
/repos/

# Generated repowise indexes — built on demand by the harness on first run.
# Exception: the flask48-v2 full index is committed so the C2 arm reproduces
# without paying doc-generation cost (gpt-5.4-nano docs + openai embeddings,
# flask @ 7ee9ceb). Only the LLM-cost artifacts are tracked — parse/centrality
# caches and job state are regenerable.
/indexes/*
!/indexes/pallets_flask_full/
/indexes/pallets_flask_full/*
!/indexes/pallets_flask_full/.repowise/
/indexes/pallets_flask_full/.repowise/*
!/indexes/pallets_flask_full/.repowise/wiki.db
!/indexes/pallets_flask_full/.repowise/config.yaml
!/indexes/pallets_flask_full/.repowise/lancedb/

# Per-run logs and raw outputs — useful locally, not part of the published artifact
/logs/

# Scratch / working directories
/scratch_*/
/tmp/

# Result archives — only the canonical results/swe_qa_flask48/ and
# results/swe_qa_sklearn48/ directories are tracked. Anything else under
# results/ is treated as ad-hoc and ignored.
/results/*
!/results/swe_qa_flask48/
!/results/swe_qa_flask48/swe_qa.jsonl
!/results/swe_qa_flask48/experiment_meta.json
!/results/swe_qa_sklearn48/
!/results/swe_qa_sklearn48/swe_qa.jsonl
!/results/swe_qa_sklearn48/experiment_meta.json
!/results/swe_qa_flask48_v2/
!/results/swe_qa_flask48_v2/swe_qa.jsonl
!/results/swe_qa_flask48_v2/experiment_meta.json
!/results/health_defect_*/

# Bakeoff 2026-08: the raw runs behind every number in the OSS docs/BENCHMARKS.md.
# Published tables cite these paths, so the evidence has to be in the repo a
# skeptic clones. Predictions, graded cells and reports are tracked; agent stdout
# logs are not, because they are 49 MB of transcript that no rerun is graded on.
!/results/bakeoff_2026_08/
!/results/bakeoff_2026_08/**
/results/bakeoff_2026_08/**/logs/
/results/bakeoff_2026_08/**/__pycache__/
/results/bakeoff_2026_08/**/_backup_*/
!/results/health_defect_*/correlation.json
!/results/health_defect_*/joined_data.json
!/results/health_defect_*/defect_counts.json
!/results/calibration/
!/results/calibration/*.json
!/results/archive-pre-t0/
# Top-level aggregate outputs of the tool-comparison scripts — tracked so the
# comparison and resolution-time analyses reproduce from cache.
!/results/codescene_headtohead.json
!/results/codescene_paired_deltas.json
!/results/resolution_time.json
!/results/pr_effort_signals.json
# ICSE paper evidence artifacts — small JSON summaries the paper's numbers cite
# (the canonical wall, effort curve, TOST, and the R&R experiment gates). Tracked
# so every headline figure reproduces from cache; the heavy per-repo inputs stay local.
!/results/error_analysis_21repo.json
!/results/error_analysis_21repo_fixedcuts.json
!/results/within_band_ci.json
!/results/f4_curve.json
!/results/bootstrap_tost.json
!/results/prior_defect_ablation.json
!/results/positive_control.json
!/results/refit_bootstrap_tost.json

# Heavy per-repo extraction caches — regenerable from the repo checkouts, too
# large for git (70+ MB each across the corpus). The derived scorecards and
# per-hunk aggregates above ARE tracked.
/results/health_defect_*/hunk_dataset.json
/results/health_defect_*/hunk_tokens.json

# MCP server arm configs — may embed live API keys or absolute local paths;
# regenerate per machine, never commit.
/mcp_configs/

# Repomix packed-repo artifacts — multi-MB, reproducible from the pinned
# repomix version + the staged repo (commands recorded in the repro docs).
/data/context_bench/repomix_packs/

# Local experiment scratch — Ollama modelfiles, smoke logs, ad-hoc dumps
Modelfile.*
logs_smoke*.txt
*_index.log
tool_health_dump.json

# opencode source clone (inspection only, local)
opencode-src/

# SWE-bench validation: generated artifacts (regenerable, heavy, or local-only).
# (gitignore has no inline comments — keep each comment on its own line.)
# sparse clone of swe-bench/experiments (leaderboard dumps)
/experiments/
# per-instance native test venvs
/swebench_venvs/
# official swebench package venv (Windows orchestration)
/swebench_harness_venv/
# per-instance repowise index-only caches
/indexes_swebench/
# per-instance base_commit worktrees
/scratch_swebench/
# generated per-instance MCP configs for the swe_bench arm
/mcp_configs/scratch_swebench_*.json
# ad-hoc gold-gate dumps
results_swebench_goldgate_*.json

# Third-party graders and datasets, cloned not vendored. `external/ContextBench`
# is a nested git checkout (EuniAI/ContextBench, Apache-2.0) plus its own
# `.venv-grader`; it is recreated by the command recorded in the rung 8 RESULT.md
# rather than committed here. `data/contextbench` holds the HF parquets.
/external/
/data/contextbench/

# Isolated CLAUDE_CONFIG_DIR for benchmark subprocesses. Holds a hard link to
# the operator's OAuth credentials; never commit it.
.claude_bench_home/

# Generated per (arm, run): MCP configs and pinned per-arm settings.
mcp_configs/

# Bench-owned CODEX_HOME. Holds a HARD LINK to ~/.codex/auth.json, which is
# the operator's OAuth credential; never commit it. `--ignore-user-config`
# does NOT suppress $CODEX_HOME/hooks.json, so this directory being clean is
# the isolation mechanism rather than a convenience — see
# harness/codex_isolation_probe.py.
.codex_bench_home/

# Throwaway CODEX_HOMEs the isolation probe plants a sentinel hook into.
.codex_probe_scratch/
# Context-tool benchmark results: raw JSONL + aggregates are the published
# artifact (repo precedent); per-run transcripts under logs/ stay local.
!/results/context_bench/
!/results/context_bench/**

# Per-arm MCP configs written under a results/ run directory. These carry a live
# OPENAI_API_KEY in their `env` block, the same hazard as /mcp_configs/ above,
# and the `!/results/bakeoff_2026_08/**` un-ignore would otherwise pull them in.
/results/**/arms/
/results/**/arms-s2/

# Per-session agent stream transcripts. 43 MB for the session-cost cells alone,
# and nothing is graded on them: the graded artifacts are sessions*.jsonl and the
# gate_post__* scores beside them. Same rule as the **/logs/ exclusion above.
/results/**/_status_*/

# Ad-hoc overnight run logs dropped at the repo root.
/logs_*.log

# Graph-quality results. Small JSON aggregates that graph/ cites by path, so
# they have to be in the repo a skeptic clones.
!/results/graph/
!/results/graph/**
